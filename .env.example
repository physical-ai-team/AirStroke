# AirStroke 설정 — 이 파일을 .env로 복사해서 사용 (.env는 커밋 금지)
#   copy .env.example .env
# 값을 바꾼 뒤에는 docker compose up -d 로 재기동 (빌드 불필요)

# ---------- 네트워크 ----------
# QR 코드에 들어갈 PC의 LAN IP. tools/gen_cert.py 가 고른 IP로 채워준다.
PUBLIC_HOST=
# 호스트에서 열 gateway 포트 (HTTPS)
GATEWAY_PORT=8443
# 로컬(conda) 도구가 접속할 Redis. compose 안의 서비스는 redis://redis:6379/0 으로 덮어쓴다.
REDIS_URL=redis://localhost:6379/0
REDIS_HOST_PORT=6379
SESSION_TTL_SEC=3600
# 폰·PC 시계 차이 추정: ping 주기(초), RTT 최소값을 고를 최근 샘플 수
CLOCK_PING_INTERVAL_SEC=2
CLOCK_SAMPLES=10

# ---------- 폰 카메라 / 프레임 (Zoom 시연 중 부하가 크면 여기부터 낮출 것) ----------
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
# 1~100
JPEG_QUALITY=70
# 응답 없이 동시에 보낼 수 있는 최대 프레임 수. 초과하면 새 프레임은 버린다.
MAX_INFLIGHT_FRAMES=2

# ---------- vision ----------
NUM_HANDS=1
MIN_HAND_DETECTION_CONFIDENCE=0.5
MIN_HAND_PRESENCE_CONFIDENCE=0.5
MIN_TRACKING_CONFIDENCE=0.5
# 이 시간 동안 프레임이 없으면 세션의 HandLandmarker를 해제
VISION_SESSION_IDLE_SEC=30

# ---------- gesture ----------
# 같은 제스처가 N프레임 연속이어야 확정
DEBOUNCE_FRAMES=3
# 카메라 중앙 몇 %를 캔버스 전체로 매핑할지 (0~1)
ACTIVE_AREA=0.7
ONE_EURO_MIN_CUTOFF=1.0
ONE_EURO_BETA=0.007
ONE_EURO_D_CUTOFF=1.0

# ---------- 로깅 / 헬스체크 ----------
LOG_LEVEL=INFO
STATS_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=5
